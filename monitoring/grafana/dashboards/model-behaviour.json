{
  "__inputs": [],
  "__requires": [],
  "uid": "ddm501-model",
  "title": "DDM501 \u2014 Model Behaviour",
  "description": "Model behaviour: input drift, prediction score quantiles, decision mix, group selection rates, fairness gap, explanation latency, and prediction errors.",
  "tags": [
    "ddm501",
    "lab04",
    "model"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 3,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Is the model still looking at the same world?",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": [],
      "id": 1
    },
    {
      "type": "stat",
      "title": "Drift score (max PSI)",
      "description": "Maximum feature PSI: <0.10 stable, 0.10-0.25 moderate, >=0.25 significant. Check Window size alongside this value: below 200 requests the service reports zero without enough data to measure drift.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 5,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-ddm501"
      },
      "targets": [
        {
          "expr": "ml_drift_score",
          "legendFormat": "PSI",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-ddm501"
          },
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 0.25
              }
            ]
          },
          "noValue": "Not measuring",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Not measuring",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Window size",
      "description": "Requests in the current drift window. Below 200 requests, drift is not reliable; the drift score can be zero because it is not yet measured.",
